# ==============================================================================
# CareTrail: Environment Configuration Template (.env.example)
#
# SECURITY & COMPLIANCE RULES:
# - NEVER commit real credentials, production connection strings, or secret keys.
# - Copy this template to '.env' for local runtime execution.
# - Do NOT prefix server-side secrets with VITE_ (avoids browser bundle exposure).
# - Missing optional credentials will NEVER prevent the main application from starting.
# ==============================================================================

# ==============================================================================
# SECTION A: REQUIRED SERVER CONFIGURATION
# Both SESSION_SECRET and DATABASE_URL are required for the server to run.
# They are validated securely at server startup without printing secret values.
# ==============================================================================

# Node runtime environment ('development' | 'production' | 'test')
NODE_ENV="development"

# Server listening port (default: 3000)
PORT=3000

# Public origin URL of the running application
# Used for CORS validation, redirect callbacks, and self-referential links.
# Local development default: http://localhost:3000
# Production deployment: Cloud Run or custom domain (e.g. https://caretrail.example.com)
APP_URL="http://localhost:3000"

# SESSION_SECRET [REQUIRED FOR SERVER OPERATION]
# ------------------------------------------------------------------------------
# Cryptographically strong 32-byte secret used to sign server-side session cookies
# and verify RBAC tenant tokens with HMAC-SHA256 entropy.
#
# HOW TO SECURELY GENERATE:
#   Option 1 (OpenSSL - Recommended):
#     openssl rand -base64 32
#   Option 2 (Node.js crypto):
#     node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# SECURITY NOTICE:
# - Must be at least 32 characters long.
# - NEVER hardcode into source code or commit to version control.
# - NEVER expose to client-side code or prefix with VITE_.
# - Server-side only (cookies set with HttpOnly, SameSite=Strict, Secure in production).
SESSION_SECRET="CHANGE_ME_TO_A_SECURE_RANDOM_SESSION_SECRET_STRING_32_CHARS"

# DATABASE_URL [REQUIRED FOR PERSISTENT POSTGRESQL STORE]
# ------------------------------------------------------------------------------
# PostgreSQL 15+ connection URI.
#
# HOW TO CONFIGURE USING A HOSTED POSTGRESQL DATABASE:
# 1. Choose a hosted PostgreSQL provider (Google Cloud SQL, Supabase, Neon, AWS RDS, etc.).
# 2. Format:
#    postgresql://[DB_USER]:[DB_PASSWORD]@[DB_HOST]:[DB_PORT]/[DB_NAME]?sslmode=require
# 3. Provider Examples:
#    - Google Cloud SQL: postgresql://caretrail:[PASSWORD]@[INSTANCE_IP]:5432/caretrail?sslmode=require
#    - Supabase:         postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require
#    - Neon:             postgresql://[USER]:[PASSWORD]@[ENDPOINT].neon.tech/neondb?sslmode=require
#
# SECURITY NOTICE:
# - Server validates the presence of DATABASE_URL securely without printing connection credentials.
DATABASE_URL="postgresql://caretrail_user:caretrail_password@localhost:5432/caretrail_db?schema=public"

# DATABASE_POOL_MAX [OPTIONAL - SENSIBLE DEFAULT: 5]
# ------------------------------------------------------------------------------
# Maximum number of concurrent connections in the PostgreSQL client pool.
# - Default: 5 (safe default for serverless containers like Cloud Run and shared
#   hosted DB tiers to avoid exhausting database connection limits).
# - Override: Can be explicitly set to higher values (e.g. 10, 20) for dedicated high-throughput hosts.
DATABASE_POOL_MAX=5

# ==============================================================================
# SECTION B: OPTIONAL INTEGRATIONS
# Missing optional credentials will NOT prevent the application from starting.
# Integrations remain disabled with honest status indicators until configured.
# ==============================================================================

# DOCUMENT STORAGE [OPTIONAL - UNCONFIGURED BY DEFAULT]
# ------------------------------------------------------------------------------
# External cloud storage is completely optional during initial setup.
# When no valid storage provider is configured, CareTrail honestly displays that
# document storage is not configured, keeping files in temporary session memory only.
# It will NEVER claim that files are securely or permanently saved when unconfigured.
#
# STORAGE_PROVIDER: 'gcs' | 's3' | (leave empty or 'local' for unconfigured memory buffer)
STORAGE_PROVIDER=""
# STORAGE_BUCKET: Name of the private cloud bucket (e.g. 'my-caretrail-docs-bucket')
STORAGE_BUCKET=""
# STORAGE_REGION: Target cloud storage region (e.g. 'asia-south1')
STORAGE_REGION="asia-south1"

# ABDM SANDBOX GATEWAY [OPTIONAL - DISABLED BY DEFAULT]
# ------------------------------------------------------------------------------
# National Health Authority (NHA) Ayushman Bharat Digital Mission sandbox connector.
# Requires all 4 variables to be enabled: Client ID, Secret, Gateway URL, and Facility ID.
# Until real, valid NHA sandbox credentials and facility configuration are provided,
# the ABDM integration remains DISABLED (status: NOT_CONFIGURED, diagnostic probe: HTTP 503).
# CareTrail will NEVER fabricate credentials or pretend a live ABDM connection exists.
ABDM_SANDBOX_CLIENT_ID=""
ABDM_SANDBOX_CLIENT_SECRET=""
ABDM_GATEWAY_URL="https://dev.abdm.gov.in/gateway/v0.5"
ABDM_FACILITY_ID="IN2910000001"

# NIC E-HOSPITAL BRIDGE [OPTIONAL - DISABLED BY DEFAULT]
# ------------------------------------------------------------------------------
# National Informatics Centre (NIC) e-Hospital institutional bridge.
# Requires authorized client token and facility code.
# Until real, authorized institutional credentials are provided, e-Hospital remains
# DISABLED (status: NOT_CONFIGURED, diagnostic probe: HTTP 503).
# CareTrail will NEVER create fake successful API responses.
EHOSPITAL_CLIENT_TOKEN=""
EHOSPITAL_FACILITY_CODE=""

# GEMINI CLINICAL AI [OPTIONAL - INJECTED AUTOMATICALLY IN AI STUDIO]
# ------------------------------------------------------------------------------
# Google Gemini API key used for assistive pre-consultation synthesis and OCR extraction.
# - In Google AI Studio: Injected automatically via the Secrets panel.
# - When omitted: Clinical workspace operates deterministically without crashing.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
